---
import '../styles/global.css';
import { site, ruta } from '../data/site.js';
import { contenido } from '../data/contenido.js';
import { traducir } from '../i18n/ui.js';
import {
  hreflang,
  idiomaPredeterminado,
  idiomas,
  localeHtml,
  localeOg,
  otroIdioma,
  rutaDe,
  rutas,
} from '../i18n/config.js';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const {
  idioma = idiomaPredeterminado,
  // Id de la tabla de rutas. En null (el 404) la página no es una ruta
  // real: no lleva canonical ni alternas de idioma.
  paginaId = null,
  titulo,
  descripcion,
  ogTitulo = titulo,
  ogDescripcion = descripcion,
  noindex = false,
} = Astro.props;

const c = contenido(idioma);
const t = traducir(idioma);

// El selector de idioma del encabezado necesita una página a la que ir;
// desde el 404 lleva a la portada del otro idioma.
const paginaHeader = paginaId ?? 'inicio';

const enRutas = paginaId !== null && Object.hasOwn(rutas, paginaId);

// El canonical sale de la tabla de rutas, no del pathname: así coincide
// siempre con lo que emiten el sitemap y las etiquetas hreflang.
const canonical = enRutas
  ? new URL(rutaDe(paginaId, idioma), Astro.site).href
  : null;

const alternas = enRutas
  ? idiomas.map((codigo) => ({
      codigo,
      hreflang: hreflang[codigo],
      href: new URL(rutaDe(paginaId, codigo), Astro.site).href,
    }))
  : [];

const ogImagen = new URL(ruta('/og.png'), Astro.site).href;

const organizacion = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Vertek',
  alternateName: 'Vertek Industrial Holding',
  url: new URL(ruta('/'), Astro.site).href,
  email: site.correo,
  description: c.claimCorto,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'San Pedro Garza García',
    addressRegion: 'Nuevo León',
    addressCountry: 'MX',
  },
  areaServed: { '@type': 'Country', name: 'México' },
  subOrganization: c.empresas.map((e) => ({
    '@type': 'Organization',
    name: e.nombre,
    description: e.categoria,
    ...(e.href ? { url: e.href } : {}),
  })),
};
---

<!doctype html>
<html lang={localeHtml[idioma]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#ffffff" />
    {noindex && <meta name="robots" content="noindex, follow" />}

    {/* Versiones por idioma. x-default apunta al español, que es el
        idioma principal del sitio. */}
    {
      alternas.map((a) => (
        <link rel="alternate" hreflang={a.hreflang} href={a.href} />
      ))
    }
    {
      enRutas && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(rutaDe(paginaId, idiomaPredeterminado), Astro.site).href}
        />
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={localeOg[idioma]} />
    <meta property="og:locale:alternate" content={localeOg[otroIdioma(idioma)]} />
    <meta property="og:title" content={ogTitulo} />
    <meta property="og:description" content={ogDescripcion} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content="Vertek" />
    <meta property="og:image" content={ogImagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Vertek — Industrial Holding" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImagen} />

    <link rel="icon" href={ruta('/favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(organizacion)}
    />
  </head>

  <body>
    <a class="skip-link" href="#contenido">{t.irAlContenido}</a>
    <Header idioma={idioma} paginaId={paginaHeader} />
    <main id="contenido">
      <slot />
    </main>
    <Footer idioma={idioma} />

    <script>
      const items = document.querySelectorAll('.reveal');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

      if (reduce.matches || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.08, rootMargin: '0px 0px -60px 0px' }
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
