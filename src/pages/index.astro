---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Grupo from '../components/Grupo.astro';
import Empresas from '../components/Empresas.astro';
import Capacidades from '../components/Capacidades.astro';
import Sectores from '../components/Sectores.astro';
import Respaldo from '../components/Respaldo.astro';
import Contacto from '../components/Contacto.astro';
---

<Layout
  titulo="Vertek | Holding Industrial en Monterrey"
  descripcion="Vertek integra empresas especializadas en suministro, equipos y sistemas para la industria pesada, bajo un mismo respaldo corporativo. Sede en San Pedro Garza García, N.L."
  ogTitulo="Vertek — Holding Industrial"
  ogDescripcion="Un grupo industrial que resuelve toda la cadena: suministro crítico, izaje, energía, protección contra incendio e infraestructura eléctrica."
>
  <Hero />
  <Grupo />
  <Empresas />
  <Capacidades />
  <Sectores />
  <Respaldo />
  <Contacto />
</Layout>
