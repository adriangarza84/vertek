---
// Marca VERTEK: logotipo tipográfico. Palabra en sans robusta,
// regla fina y descriptor "INDUSTRIAL HOLDING" en gris acero.
const {
  // 'full' = palabra + regla + descriptor · 'word' = solo la palabra
  variant = 'full',
  // Tamaño de la palabra, en rem
  size = 1.55,
  class: className = '',
} = Astro.props;
---

<span
  class={`logo ${className}`}
  style={`--logo-size:${size}rem`}
  data-variant={variant}
>
  <span class="logo__word">Vertek</span>
  {
    variant === 'full' && (
      <>
        <span class="logo__rule" aria-hidden="true" />
        <span class="logo__desc">Industrial Holding</span>
      </>
    )
  }
</span>

<style>
  .logo {
    display: inline-flex;
    flex-direction: column;
    align-items: stretch;
    /* Hugga el contenido: la regla debe medir lo mismo que la palabra */
    width: max-content;
    color: inherit;
    text-decoration: none;
    line-height: 1;
  }

  .logo__word {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--logo-size);
    letter-spacing: -0.005em;
    text-transform: uppercase;
    color: currentColor;
  }

  .logo__rule {
    display: block;
    height: 1px;
    background: currentColor;
    opacity: 0.45;
    margin-block: calc(var(--logo-size) * 0.2);
  }

  .logo__desc {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: calc(var(--logo-size) * 0.3);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: currentColor;
    opacity: 0.7;
    /* Compensa el tracking del último carácter para centrar el bloque */
    margin-right: -0.18em;
    text-align: center;
  }
</style>
