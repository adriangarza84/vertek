---
import { site } from '../data/site.js';
import { contenido } from '../data/contenido.js';
import { traducir } from '../i18n/ui.js';
import { rutaDe } from '../i18n/config.js';

const { idioma } = Astro.props;
const { contacto } = contenido(idioma);
const t = traducir(idioma);

// El aviso de privacidad del idioma actual, no el de la versión en español.
const rPrivacidad = rutaDe('privacidad', idioma);
---

<section class="section section--line" id="contacto" aria-labelledby="contacto-titulo">
  <div class="wrap cont__inner">
    <div class="cont__izq reveal">
      <p class="eyebrow">{contacto.eyebrow}</p>
      <h2 class="title" id="contacto-titulo">{contacto.titulo}</h2>
      <p class="lede">{contacto.cuerpo}</p>

      <dl class="cont__datos">
        <div>
          <dt>{t.contactoCorreoGrupo}</dt>
          <dd>
            <a class="link-tec" href={`mailto:${site.correo}`}>{site.correo}</a>
          </dd>
        </div>
        <div>
          <dt>{t.contactoSede}</dt>
          <dd>{site.ciudad}</dd>
        </div>
      </dl>
    </div>

    <form
      class="form reveal"
      data-form
      method="POST"
      action={site.formEndpoint || undefined}
      aria-labelledby="contacto-titulo"
      data-destino={site.correo}
      data-enviando={t.formEnviando}
      data-exito={t.formExito}
      data-error-validacion={t.formErrorValidacion}
      data-error-servidor={t.formErrorServidor}
      data-error-red={t.formErrorRed}
      data-enviar={t.formEnviar}
    >
      {/* El idioma viaja con el envío: decide la copia del aviso y de la
          página de respuesta cuando el visitante no tiene JavaScript. */}
      <input type="hidden" name="lang" value={idioma} />

      <div class="form__campo">
        <label for="nombre">{t.formNombre}</label>
        <input id="nombre" name="nombre" type="text" required autocomplete="name" />
      </div>

      <div class="form__campo">
        <label for="empresa">{t.formEmpresa}</label>
        <input
          id="empresa"
          name="empresa"
          type="text"
          required
          autocomplete="organization"
        />
      </div>

      <div class="form__fila">
        <div class="form__campo">
          <label for="correo">{t.formCorreo}</label>
          <input
            id="correo"
            name="correo"
            type="email"
            required
            autocomplete="email"
          />
        </div>
        <div class="form__campo">
          <label for="telefono">{t.formTelefono}</label>
          <input
            id="telefono"
            name="telefono"
            type="tel"
            autocomplete="tel"
            inputmode="tel"
          />
        </div>
      </div>

      <div class="form__campo">
        <label for="mensaje">{t.formMensaje}</label>
        <textarea id="mensaje" name="mensaje" rows="5" required></textarea>
      </div>

      <!-- Trampa para robots: no la ven las personas -->
      <input
        class="sr-only"
        type="text"
        name="_gotcha"
        tabindex="-1"
        aria-hidden="true"
      />

      <button class="btn btn--primary form__enviar" type="submit">
        {t.formEnviar}
      </button>

      {/* El resultado del envío se anuncia aquí; aria-live lo lee en voz
          alta sin mover el foco. */}
      <p class="form__estado" data-estado role="status" aria-live="polite"></p>

      <p class="form__nota">
        {t.formNotaAntes}<a href={rPrivacidad}>{t.formNotaEnlace}</a>{t.formNotaDespues}
      </p>
    </form>
  </div>
</section>

<style>
  .cont__inner {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
  }

  .cont__datos {
    margin: 2.5rem 0 0;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
  }

  .cont__datos dt {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--steel-500);
    padding-bottom: 0.55rem;
    border-bottom: 1px solid var(--concrete-200);
    margin-bottom: 0.7rem;
  }

  .cont__datos dd {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
    color: var(--ink-900);
  }

  .form {
    display: grid;
    gap: 1.2rem;
    align-content: start;
    background: var(--concrete-50);
    border: 1px solid var(--concrete-200);
    border-top: 3px solid var(--ink-900);
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }

  .form__fila {
    display: grid;
    gap: 1.2rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
  }

  .form__campo {
    display: grid;
    gap: 0.45rem;
  }

  .form__campo label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--steel-500);
  }

  .form__campo input,
  .form__campo textarea {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--ink-900);
    background: var(--white);
    border: 1px solid var(--concrete-300);
    border-radius: 0;
    padding: 0.8rem 0.9rem;
    width: 100%;
    transition: border-color 0.16s ease;
  }

  .form__campo textarea {
    resize: vertical;
    line-height: 1.6;
  }

  .form__campo input:hover,
  .form__campo textarea:hover {
    border-color: var(--steel-400);
  }

  .form__campo input:focus,
  .form__campo textarea:focus {
    outline: none;
    border-color: var(--ink-900);
    box-shadow: inset 0 0 0 1px var(--ink-900);
  }

  .form__enviar {
    margin-top: 0.6rem;
    justify-self: start;
  }

  .form__nota {
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--steel-500);
  }

  .form__nota a {
    color: var(--ink-800);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (min-width: 940px) {
    .cont__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
      align-items: start;
    }
  }

  /* ---------- Estado del envío ---------- */

  .form__estado:empty {
    display: none;
  }

  .form__estado {
    margin-top: 1rem;
    padding: 0.85rem 1rem;
    border-left: 3px solid var(--steel-500);
    background: var(--concrete-50);
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--ink-700);
  }

  .form__estado[data-tono='exito'] {
    border-left-color: var(--ink-900);
    color: var(--ink-900);
  }

  .form__estado[data-tono='error'] {
    border-left-color: #a3282b;
    color: #8c2326;
  }

  .form :global([aria-invalid='true']) {
    border-color: #a3282b;
  }
</style>

<script>
  // Envío del formulario de contacto.
  //
  // Sin JavaScript el formulario hace POST nativo y la función serverless
  // responde con una página. Con JavaScript lo enviamos por fetch para no
  // sacar al visitante de la página.
  //
  // Donde no hay servidor (la vista previa estática de GitHub Pages) el
  // formulario se queda sin `action`: ahí caemos a un mailto en lugar de
  // fingir un envío que nadie recibiría.
  const form = document.querySelector('[data-form]');

  if (form) {
    const boton = form.querySelector('[type="submit"]');
    const salida = form.querySelector('[data-estado]');
    const endpoint = form.getAttribute('action');

    const txt = {
      destino: form.dataset.destino,
      enviando: form.dataset.enviando,
      exito: form.dataset.exito,
      errorValidacion: form.dataset.errorValidacion,
      errorServidor: form.dataset.errorServidor,
      errorRed: form.dataset.errorRed,
      enviar: form.dataset.enviar,
    };

    const mostrar = (mensaje, tono) => {
      if (!salida) return;
      salida.textContent = mensaje;
      salida.dataset.tono = tono;
    };

    const marcar = (campos) => {
      form
        .querySelectorAll('[aria-invalid]')
        .forEach((el) => el.removeAttribute('aria-invalid'));
      (campos || []).forEach((campo) => {
        const el = form.querySelector(`[name="${campo}"]`);
        if (el) el.setAttribute('aria-invalid', 'true');
      });
    };

    if (!endpoint) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const datos = new FormData(form);
        const lineas = [];
        for (const [clave, valor] of datos.entries()) {
          if (clave.startsWith('_') || clave === 'lang') continue;
          if (String(valor).trim()) lineas.push(`${clave}: ${valor}`);
        }
        const asunto = `Contacto desde el sitio — ${datos.get('nombre') || ''}`;
        window.location.href = `mailto:${txt.destino}?subject=${encodeURIComponent(
          asunto
        )}&body=${encodeURIComponent(lineas.join('\n'))}`;
      });
    } else {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (boton.disabled) return;

        const datos = Object.fromEntries(new FormData(form).entries());

        marcar([]);
        boton.disabled = true;
        boton.textContent = txt.enviando;
        mostrar(txt.enviando, 'espera');

        try {
          const respuesta = await fetch(endpoint, {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(datos),
          });
          const cuerpo = await respuesta.json().catch(() => ({}));

          if (respuesta.ok && cuerpo.ok) {
            form.reset();
            mostrar(txt.exito, 'exito');
          } else if (cuerpo.error === 'validacion') {
            marcar(cuerpo.campos);
            mostrar(txt.errorValidacion, 'error');
          } else {
            mostrar(txt.errorServidor, 'error');
          }
        } catch {
          mostrar(txt.errorRed, 'error');
        } finally {
          boton.disabled = false;
          boton.textContent = txt.enviar;
        }
      });
    }
  }
</script>
