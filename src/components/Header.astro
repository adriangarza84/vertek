---
import Logo from './Logo.astro';
import { contenido } from '../data/contenido.js';
import { traducir } from '../i18n/ui.js';
import {
  ancla,
  hreflang,
  otroIdioma,
  rutaDe,
} from '../i18n/config.js';

const { idioma, paginaId } = Astro.props;

const c = contenido(idioma);
const t = traducir(idioma);

const otro = otroIdioma(idioma);
// El selector lleva a la página equivalente, no a la portada.
const rOtroIdioma = rutaDe(paginaId, otro);
---

<header class="header" data-header>
  <div class="wrap header__inner">
    <a
      class="header__brand"
      href={rutaDe('inicio', idioma)}
      aria-label={t.navIrAlInicio}
    >
      <Logo variant="full" size={1.35} />
    </a>

    <nav class="header__nav" aria-label={t.navPrincipal}>
      {
        c.nav.map((item) => (
          <a
            class="header__link"
            href={ancla(item.href, idioma)}
            data-spy={item.href}
          >
            {item.titulo}
          </a>
        ))
      }
    </nav>

    <a
      class="header__idioma"
      href={rOtroIdioma}
      lang={otro}
      hreflang={hreflang[otro]}
      title={t.idiomaCambiar}
    >
      <span class="sr-only">{t.idiomaCambiar}</span>
      <span aria-hidden="true">
        <b>{t.idiomaCodigoActual}</b><i>/</i>{t.idiomaCodigoOtro}
      </span>
    </a>

    <a
      class="btn btn--primary btn--sm header__cta"
      href={ancla('#contacto', idioma)}
    >
      {t.ctaContacto}
    </a>

    <button
      class="burger"
      type="button"
      aria-label={t.navAbrirMenu}
      aria-expanded="false"
      aria-controls="menu-movil"
      data-abrir={t.navAbrirMenu}
      data-cerrar={t.navCerrarMenu}
    >
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="movil" id="menu-movil" hidden>
    <div class="wrap movil__inner">
      {
        c.nav.map((item) => (
          <a class="movil__link" href={ancla(item.href, idioma)}>
            {item.titulo}
          </a>
        ))
      }
      <a
        class="btn btn--primary movil__cta"
        href={ancla('#contacto', idioma)}
      >
        {t.ctaContactarGrupo}
      </a>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid var(--concrete-100);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .header.is-stuck {
    border-bottom-color: var(--concrete-200);
    box-shadow: 0 1px 20px -12px rgba(20, 22, 26, 0.35);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 78px;
  }

  .header__brand {
    text-decoration: none;
    color: var(--ink-900);
    margin-right: auto;
  }

  .header__nav {
    display: none;
    align-items: center;
    gap: 1.9rem;
    font-family: var(--font-mono);
    font-size: 0.7188rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .header__link {
    color: var(--steel-500);
    text-decoration: none;
    padding-block: 0.5rem;
    border-bottom: 1px solid transparent;
    transition: color 0.16s ease, border-color 0.16s ease;
  }

  .header__link:hover,
  .header__link.is-active {
    color: var(--ink-900);
    border-bottom-color: var(--ink-900);
  }

  /* ---------- Selector de idioma ----------
     Siempre visible, también en móvil: es el control que permite
     salir de un idioma que no entiendes. */

  .header__idioma {
    flex: none;
    display: inline-flex;
    align-items: center;
    height: 34px;
    padding-inline: 0.7rem;
    border: 1px solid var(--concrete-200);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    color: var(--steel-500);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.16s ease, border-color 0.16s ease;
  }

  .header__idioma:hover {
    color: var(--ink-900);
    border-color: var(--ink-800);
  }

  /* El idioma activo se marca en oscuro; el otro queda en gris. */
  .header__idioma b {
    font-weight: 500;
    color: var(--ink-900);
  }

  .header__idioma i {
    font-style: normal;
    padding-inline: 0.3rem;
    color: var(--concrete-200);
  }

  .burger {
    width: 42px;
    height: 42px;
    display: grid;
    place-content: center;
    gap: 5px;
    background: transparent;
    border: 1px solid var(--concrete-200);
    border-radius: 0;
    cursor: pointer;
  }

  .burger span {
    display: block;
    width: 20px;
    height: 1px;
    background: var(--ink-800);
  }

  .movil {
    border-top: 1px solid var(--concrete-100);
    background: var(--white);
    max-height: calc(100vh - 78px);
    overflow-y: auto;
  }

  .movil__inner {
    display: flex;
    flex-direction: column;
    padding-block: 0.5rem 1.75rem;
  }

  .movil__link {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--ink-900);
    text-decoration: none;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--concrete-100);
  }

  .movil__cta {
    margin-top: 1.5rem;
  }

  @media (min-width: 1000px) {
    .header__nav {
      display: flex;
    }
    .burger,
    .movil {
      display: none !important;
    }
  }

  @media (max-width: 999px) {
    .header__cta {
      display: none;
    }
    .header__inner {
      gap: 0.75rem;
    }
  }
</style>

<script>
  const header = document.querySelector('[data-header]');
  const burger = document.querySelector('.burger');
  const panel = document.getElementById('menu-movil');

  // Las etiquetas vienen del marcado para que el script sirva igual en
  // español y en inglés.
  const etiquetaAbrir = burger?.dataset.abrir ?? 'Abrir menú';
  const etiquetaCerrar = burger?.dataset.cerrar ?? 'Cerrar menú';

  burger?.addEventListener('click', () => {
    const abierto = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!abierto));
    burger.setAttribute('aria-label', abierto ? etiquetaAbrir : etiquetaCerrar);
    if (panel) panel.hidden = abierto;
  });

  // Cierra el menú móvil al elegir una ancla
  panel?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      panel.hidden = true;
      burger?.setAttribute('aria-expanded', 'false');
      burger?.setAttribute('aria-label', etiquetaAbrir);
    })
  );

  // Sombra al separarse del tope
  const marcarStuck = () =>
    header?.classList.toggle('is-stuck', window.scrollY > 8);
  marcarStuck();
  window.addEventListener('scroll', marcarStuck, { passive: true });

  // Resalta la sección visible en la navegación
  const enlaces = [...document.querySelectorAll('[data-spy]')];
  const secciones = enlaces
    .map((a) => document.querySelector(a.dataset.spy))
    .filter(Boolean);

  if ('IntersectionObserver' in window && secciones.length) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          enlaces.forEach((a) =>
            a.classList.toggle('is-active', a.dataset.spy === `#${entry.target.id}`)
          );
        });
      },
      { rootMargin: '-45% 0px -50% 0px' }
    );
    secciones.forEach((s) => io.observe(s));
  }
</script>
