---
import { contenido } from '../data/contenido.js';

const { idioma } = Astro.props;
const { respaldo } = contenido(idioma);
---

<section
  class="section section--dark"
  id="respaldo"
  aria-labelledby="respaldo-titulo"
>
  <div class="resp__grid grid-bg--dark" aria-hidden="true"></div>

  <div class="wrap resp__inner">
    <div class="resp__top reveal">
      <div>
        <p class="eyebrow">{respaldo.eyebrow}</p>
        <h2 class="title" id="respaldo-titulo">{respaldo.titulo}</h2>
      </div>
      <div class="prose">
        {respaldo.cuerpo.map((p) => <p>{p}</p>)}
      </div>
    </div>

    <dl class="resp__datos reveal">
      {
        respaldo.datos.map((d) => (
          <div class="stat">
            <dt class="stat__k">{d.k}</dt>
            <dd class="stat__v">{d.v}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .section--dark {
    position: relative;
    overflow: hidden;
  }

  .resp__grid {
    position: absolute;
    inset: 0;
    mask-image: radial-gradient(
      120% 90% at 85% 0%,
      #000 0%,
      transparent 70%
    );
    -webkit-mask-image: radial-gradient(
      120% 90% at 85% 0%,
      #000 0%,
      transparent 70%
    );
  }

  .resp__inner {
    position: relative;
  }

  .resp__top {
    display: grid;
    gap: 2.25rem;
  }

  .resp__datos {
    margin: clamp(3rem, 6vw, 4.75rem) 0 0;
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
  }

  .resp__datos .stat__v {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 0.9375rem;
    line-height: 1.62;
    color: var(--steel-300);
  }

  .resp__datos .stat__k {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.01em;
    text-transform: none;
    color: var(--white);
  }

  @media (min-width: 900px) {
    .resp__top {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: start;
    }
  }
</style>
